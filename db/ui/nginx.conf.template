server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Writes can carry large batches (turbopuffer allows up to 512 MB; we cap lower).
    client_max_body_size 64m;

    # tp_ring_default: the query nodes on a consistent-hash ring keyed by
    # namespace (generated by backends.sh from QUERY_RING).
    location /api/ {
        proxy_pass http://tp_ring_default/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
        # Never retry a write on another node after it was sent: the first node
        # may already have committed it. Upserts are idempotent, but that's the
        # client's decision to make, not the proxy's.
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;
        # Show the routing: the hash key and the query node that answered.
        add_header X-Temupuffer-Route-Key $tp_ns always;
        add_header X-Temupuffer-Upstream $upstream_addr always;
    }

    # Extra backends (BACKENDS env), generated at startup by backends.sh.
    include /etc/nginx/conf.d/backends.inc;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app: unknown paths serve index.html and React Router takes over.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}

# The API router: the same ring on its own port, with the API at the root
# (/v2/namespaces/...) instead of under /api/. Deployed as temupuffer-router
# (deploy/components/api-router) behind the API hostname.
server {
    listen 8081;
    server_name _;
    client_max_body_size 64m;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://tp_ring_default;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;
        add_header X-Temupuffer-Route-Key $tp_ns always;
        add_header X-Temupuffer-Upstream $upstream_addr always;
    }
}
